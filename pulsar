#!/usr/bin/env bash
# Root dispatcher for the Pulsar GB10 vLLM stack.
#   ./pulsar                 → wizard
#   ./pulsar wizard          → wizard (valid spaced form; avoids ./ wizard.sh)
#   ./pulsar inventory …     → scripts/inventory.sh
#   ./pulsar start <model>…  → scripts/up.sh
#   ./pulsar stop <model|--all> → scripts/down.sh
#   ./pulsar status [model]  → scripts/status.sh
#   ./pulsar help
#
# Existing scripts under scripts/ remain the canonical implementations;
# this file only routes and prints concise help.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

usage() {
  cat <<'EOF'
Pulsar GB10 vLLM stack — root dispatcher

Usage:
  ./pulsar                      Open guided wizard
  ./pulsar wizard               Same as ./pulsar (recommended form)
  ./pulsar inventory [opts]     Read-only service/memory inventory
  ./pulsar start <model> [args] Start a model (scripts/up.sh)
  ./pulsar stop <model|--all>   Stop stack-managed service(s)
  ./pulsar status [model]       Probe containers + API
  ./pulsar help                 This message

Inventory options (passed through):
  --json       Full schema_version=1 JSON
  --verbose    Human mode: include inactive unknown/legacy detail

Start args are passed to scripts/up.sh (e.g. --dry-run, --no-spec-decode).

Notes:
  • Prefer "./pulsar wizard" — not "./ wizard.sh" (space after ./ runs
    directory ./ → "Is a directory"). ./wizard.sh still works directly.
  • stop only removes containers that prove stack ownership
    (io.pulsar.gb10.managed=true + consistent conf/rank labels).
  • inventory and status are read-only; start/stop are the only mutators here.

See docs/OPERATIONS.md for model-switch safety and ownership rules.
EOF
}

cmd="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$cmd" in
  ""|wizard)
    exec "$REPO_DIR/wizard.sh" "$@"
    ;;
  inventory)
    exec "$REPO_DIR/scripts/inventory.sh" "$@"
    ;;
  start)
    [ $# -ge 1 ] || { echo "usage: ./pulsar start <model> [up.sh args...]" >&2; exit 2; }
    exec "$REPO_DIR/scripts/up.sh" "$@"
    ;;
  stop)
    [ $# -ge 1 ] || { echo "usage: ./pulsar stop <model|--all>" >&2; exit 2; }
    exec "$REPO_DIR/scripts/down.sh" "$@"
    ;;
  status)
    exec "$REPO_DIR/scripts/status.sh" "$@"
    ;;
  help|-h|--help)
    usage
    exit 0
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "Try: ./pulsar help" >&2
    exit 2
    ;;
esac
