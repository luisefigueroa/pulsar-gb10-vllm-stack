#!/usr/bin/env bash
# Root dispatcher for the Pulsar GB10 vLLM stack.
#   ./pulsar                 → neutral operator home (workflow menu)
#   ./pulsar wizard          → serve/switch wizard (doctor + preflight)
#   ./pulsar models          → catalog view + explicit refresh/preparation
#   ./pulsar inventory …     → scripts/inventory.sh
#   ./pulsar start <model>…  → scripts/up.sh
#   ./pulsar stop <model|--all> [--node ID] → scripts/down.sh
#   ./pulsar status [model] [--node ID] → scripts/status.sh (optional completion)
#   ./pulsar doctor [--json] → scripts/doctor.sh
#   ./pulsar weight-fabric … → leftover live-NFS teardown only (ADR 0005/0006)
#   ./pulsar help
#
# Existing scripts under scripts/ remain the canonical implementations;
# this file only routes and prints concise help.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCTOR_SCRIPT="${PULSAR_DOCTOR_SCRIPT:-$REPO_DIR/scripts/doctor.sh}"
cd "$REPO_DIR"

usage() {
  cat <<'EOF'
Pulsar GB10 vLLM stack — root dispatcher

Usage:
  ./pulsar                      Operator home (workflow menu; read-only default)
  ./pulsar wizard               Serve or switch a model (doctor + preflight)
  ./pulsar models               Browse storage; refresh or prepare explicitly
  ./pulsar inventory [opts]     Read-only service/memory inventory
  ./pulsar start <model> [args] Start a model (scripts/up.sh)
  ./pulsar stop <model|--all> [--node ID]
                                Stop stack-managed service(s)
  ./pulsar status [model] [--node ID]
                                Probe containers + API (may run a completion)
  ./pulsar doctor [--json]     Read-only host, cluster, and library diagnostics
  ./pulsar weight-fabric [args]
                                Leftover live-NFS show/unmount/teardown only
  ./pulsar help                 This message

Inventory options (passed through):
  --json       Full schema_version=1 JSON
  --verbose    Human mode: include hidden services and diagnostic metadata

Start args are passed to scripts/up.sh (e.g. --dry-run, --no-spec-decode).
For one-node profiles, --node NODE_ID selects a confirmed physical node for
start, status, or stop. Use the immutable node_id from inventory --json.

Notes:
  • ./pulsar (no args) opens the neutral home menu. It does not run doctor,
    inventory, or model preflight until you pick a workflow.
  • ./pulsar wizard is the direct serve/switch shortcut (existing guided flow).
  • ./pulsar models opens cached health without scanning. Catalog refresh and
    preparation are separate confirmed actions. The model library is the only
    weight mechanism (ADR 0006). Multi-rank prepare defaults to 8-stream
    SSH-over-RoCE with no fallback; one-rank prepare uses local ssh-control.
    Preparation never starts serving.
  • Prefer "./pulsar wizard" — not "./ wizard.sh" (space after ./ runs
    directory ./ → "Is a directory"). ./wizard.sh still works directly.
  • Home “Current system status” is a quick read-only overview (API model
    advertisement only — not an inference smoke). Full smoke is optional.
  • stop only removes containers that prove stack ownership
    (io.pulsar.gb10.managed=true + consistent profile/node-placement labels).
  • live NFS/RDMA serving is retired (ADR 0005). weight-fabric remains only
    for leftover show/unmount/teardown. The model library is the only weight
    mechanism (ADR 0006).
  • UI: GUM=0 / NO_COLOR / PULSAR_COLOR=never / TERM=dumb → plain menus
    (Gum not used). Color-enabled Gum always uses blue palette overrides;
    PULSAR_ACCENT overrides the accent (default 12).

See docs/OPERATIONS.md for home, ownership, and model-switch rules.
EOF
}

cmd="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$cmd" in
  "")
    exec "$REPO_DIR/scripts/home.sh"
    ;;
  wizard)
    exec "$REPO_DIR/wizard.sh" "$@"
    ;;
  models)
    exec "$REPO_DIR/scripts/model-storage.sh" "$@"
    ;;
  inventory)
    exec "$REPO_DIR/scripts/inventory.sh" "$@"
    ;;
  start)
    [ $# -ge 1 ] || { echo "usage: ./pulsar start <model> [up.sh args...]" >&2; exit 2; }
    exec "$REPO_DIR/scripts/up.sh" "$@"
    ;;
  stop)
    [ $# -ge 1 ] || { echo "usage: ./pulsar stop <model|--all> [--node NODE_ID]" >&2; exit 2; }
    exec "$REPO_DIR/scripts/down.sh" "$@"
    ;;
  status)
    exec "$REPO_DIR/scripts/status.sh" "$@"
    ;;
  doctor)
    exec "$DOCTOR_SCRIPT" "$@"
    ;;
  weight-fabric)
    exec "$REPO_DIR/scripts/weight-fabric.sh" "$@"
    ;;
  help|-h|--help)
    usage
    exit 0
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "Try: ./pulsar help" >&2
    exit 2
    ;;
esac
