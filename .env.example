# Copy to .env (gitignored) for optional runtime overrides.
# N-node membership belongs in .cluster-topology.json, generated and confirmed
# with scripts/detect-fabric.sh --write-topology. No site addresses are baked in.

# Images. Launch default is this mutable tag; the overlay Dockerfile and
# sealed canary pin sha256:ffb2d59b… (see docs/BUILD.md).
#VLLM_IMAGE_MAINLINE=vllm/vllm-openai:v0.26.0

# Host paths
#HF_CACHE=$HOME/.cache/huggingface
#MODELS_NFS=/mnt/Models

# Experimental model-library hot staging. The default reserve is the greater
# of 64 GiB or 5% of filesystem capacity on every selected rank.
#PULSAR_HOT_ROOT=/var/tmp/pulsar-hot
#PULSAR_HOT_BUDGET_BYTES=        # optional per-rank hard cap; unset by default
#PULSAR_HOT_RESERVE_BYTES=       # explicit reserve override; unset by default

# Experimental single-copy weight fabric (validated replicated caches remain
# the default). Site-local profile configs are generated under .weight-fabric/
# by scripts/weight-fabric.sh and are topology-bound.
#WEIGHT_FABRIC_DIR=/path/to/site-local/weight-fabric-configs
#WEIGHT_FABRIC_MOUNT_ROOT=/mnt/pulsar-weight-fabric
#WEIGHT_FABRIC_PORT=20049
#WEIGHT_FABRIC_HF_CLI_VERSION=1.26.1
# Passwordless is the fail-closed automation default. Set interactive only for
# commands run directly in an operator terminal; Pulsar never stores passwords.
#WEIGHT_FABRIC_SUDO_MODE=passwordless
# Optional atomic launch-to-first-health evidence (path must not exist).
#PULSAR_STARTUP_METRICS_FILE=/path/to/results/startup.json
#PULSAR_STARTUP_TAG=profile-source-cold
#PULSAR_STARTUP_CACHE_STATE=cold

# Secrets — HF_HUB_OFFLINE=1 is the default, so this is rarely needed
#HF_TOKEN=

# Optional OpenAI API auth (lab default is open / no key)
# When set, serve.sh and cluster head pass vLLM --api-key automatically.
# Clients: Authorization: Bearer <key>  or  ?api_key=
#VLLM_API_KEY=
#API_KEY=   # alias accepted if VLLM_API_KEY unset

# Optional engine CLI escape hatch (shlex-parsed into argv; quotes/spaces OK)
#VLLM_EXTRA_ARGS=--enforce-eager
#VLLM_EXTRA_ARGS=--foo "value with spaces"

# docker-compose.yml is an unsupported historical sketch. It bypasses the
# managed profile, identity, placement, preflight, and lifecycle contracts;
# these knobs apply only to that file. Use ./pulsar start <profile> instead.
#MODEL=Qwen/Qwen3.6-27B-FP8
#SERVED_NAME=qwen3.6-27b-fp8
#PORT=8000
#GPU_MEM_UTIL=0.80
#ENGINE_ARGS=--max-model-len 131072 --max-num-seqs 8

# Cluster candidate hints (optional; names do not need a dgx-spark-* pattern).
# mDNS, repeated --candidate flags, and an existing manifest are also searched.
#CLUSTER_CANDIDATES=atlas-a,atlas-b,192.0.2.42

# Multi-node runtime knobs. Per-rank control IP/interface/HCA values come from
# the confirmed manifest; these are shared policy knobs only.
#MASTER_PORT=29500
#NCCL_IB_QPS_PER_CONNECTION=4
#NCCL_DEBUG=WARN

# HEAD_IP/WORKER_IP are not honored for topology. Multi-node membership comes
# only from the confirmed .cluster-topology.json manifest
# (scripts/detect-fabric.sh --write-topology). Per-rank HCAs and interfaces
# come from that manifest at launch; these remain optional local defaults.
#NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
#NCCL_SOCKET_IFNAME=enp1s0f0np0
