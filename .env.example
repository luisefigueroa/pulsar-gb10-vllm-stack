# Copy to .env (gitignored) and adjust for your fabric.
# Cluster scripts require HEAD_IP and WORKER_IP — there are no baked-in defaults.

# Images (pinned; see docs/BUILD.md for provenance)
#VLLM_IMAGE_MAINLINE=vllm/vllm-openai:v0.26.0

# Host paths
#HF_CACHE=$HOME/.cache/huggingface
#MODELS_NFS=/mnt/Models

# Secrets — HF_HUB_OFFLINE=1 is the default, so this is rarely needed
#HF_TOKEN=

# Optional OpenAI API auth (lab default is open / no key)
# When set, serve.sh and cluster head pass vLLM --api-key automatically.
# Clients: Authorization: Bearer <key>  or  ?api_key=
#VLLM_API_KEY=
#API_KEY=   # alias accepted if VLLM_API_KEY unset

# Optional engine CLI escape hatch (shlex-parsed into argv; quotes/spaces OK)
#VLLM_EXTRA_ARGS=--enforce-eager
#VLLM_EXTRA_ARGS=--foo "value with spaces"

# docker-compose.yml single-service knobs
#MODEL=Qwen/Qwen3.6-27B-FP8
#SERVED_NAME=qwen3.6-27b-fp8
#PORT=8000
#GPU_MEM_UTIL=0.80
#ENGINE_ARGS=--max-model-len 131072 --max-num-seqs 8

# Cluster (cluster/*.sh) — REQUIRED for 2-node launch
# Example roles: dgx-spark-1 = head, dgx-spark-2 = worker
# Prefer: scripts/detect-fabric.sh --write-env   # fills HEAD/WORKER RoCE IPs + NCCL_*
# Use your RoCE rail-0 addresses (not admin/LAN). Documentation examples use
# TEST-NET ranges (192.0.2.0/24, 198.51.100.0/24); replace with your fabric.
HEAD_IP=192.0.2.1
WORKER_IP=192.0.2.2
#MASTER_PORT=29500
#NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
#NCCL_SOCKET_IFNAME=enp1s0f0np0

# Optional dual-rail preflight
#WORKER_IP_RAIL1=198.51.100.2
#HEAD_IP_RAIL1=198.51.100.1
