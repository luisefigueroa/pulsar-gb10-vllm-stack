# Copy to .env and adjust. Everything has a working default for this cluster.

# Images (pinned; see docs/BUILD.md for provenance)
#VLLM_IMAGE_MAINLINE=vllm/vllm-openai:v0.26.0
#VLLM_IMAGE_DSV4=aidendle94/sparkrun-vllm-ds4-gb10:production-ready

# Host paths
#HF_CACHE=/home/luis/.cache/huggingface
#MODELS_NFS=/mnt/Models

# Secrets — HF_HUB_OFFLINE=1 is the default, so this is rarely needed
#HF_TOKEN=hf_...

# docker-compose.yml single-service knobs
#MODEL=Qwen/Qwen3.6-27B-FP8
#SERVED_NAME=qwen3.6-27b-fp8
#PORT=8000
#GPU_MEM_UTIL=0.80
#ENGINE_ARGS=--max-model-len 131072 --max-num-seqs 8

# Cluster (cluster/*.sh); defaults are this cluster's RoCE rail-0 IPs
#HEAD_IP=10.100.120.1
#WORKER_IP=10.100.120.2
#MASTER_PORT=29500
